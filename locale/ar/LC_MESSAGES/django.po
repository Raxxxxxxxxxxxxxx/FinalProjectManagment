msgid "This request is no longer accepting quotes."
msgstr "لم يعد هذا الطلب يستقبل عروضاً."

msgid "Your supplier account must be verified before submitting quotes."
msgstr "يجب توثيق حساب المورّد قبل تقديم العروض."

msgid "You have already submitted a quote for this request."
msgstr "سبق أن أرسلت عرضاً لهذا الطلب."

msgid "You can edit only your own quotes."
msgstr "يمكنك تعديل عروضك فقط."

msgid "Your supplier account must be verified before managing quotes."
msgstr "يجب توثيق حساب المورّد قبل إدارة العروض."

msgid "This quote can no longer be edited."
msgstr "لم يعد تعديل هذا العرض متاحاً."

msgid "You can withdraw only your own quotes."
msgstr "يمكنك سحب عروضك فقط."

msgid "This quote can no longer be withdrawn."
msgstr "لم يعد سحب هذا العرض متاحاً."

msgid "Only the request owner can select the winning quote."
msgstr "يحق لصاحب الطلب وحده اختيار العرض الفائز."

msgid "A different quote has already been selected for this request."
msgstr "تم اختيار عرض آخر لهذا الطلب مسبقاً."

msgid "The selected supplier is no longer active and verified."
msgstr "لم يعد المورّد المحدد نشطاً وموثّقاً."

msgid "This request is no longer accepting a selection."
msgstr "لم يعد هذا الطلب متاحاً لاختيار عرض."

msgid "This quote is no longer available for selection."
msgstr "لم يعد هذا العرض متاحاً للاختيار."

msgid "A purchase order already exists for this request."
msgstr "يوجد أمر شراء لهذا الطلب بالفعل."

msgid "The project owner selected the quote."
msgstr "اختار صاحب المشروع هذا العرض."

msgid "You cannot perform this status transition."
msgstr "لا تملك صلاحية تنفيذ هذا الانتقال في الحالة."

msgid "Payment must be confirmed before preparation begins."
msgstr "يجب تأكيد الدفع قبل بدء التجهيز."

msgid "Only the order owner can submit payment details."
msgstr "يحق لصاحب أمر الشراء وحده إرسال بيانات الدفع."

msgid "Payment details cannot be submitted at this order stage."
msgstr "لا يمكن إرسال بيانات الدفع في هذه المرحلة من أمر الشراء."

msgid "This payment has already been confirmed."
msgstr "تم تأكيد هذه الدفعة مسبقاً."

msgid "Only platform administration can review payments."
msgstr "يحق لإدارة المنصة وحدها مراجعة الدفعات."

msgid "Unknown payment decision."
msgstr "قرار الدفع غير معروف."

msgid "Only submitted payments can be reviewed."
msgstr "لا يمكن مراجعة سوى بيانات الدفع المرسلة."

msgid ""
"Cash-on-delivery payment can no longer be reviewed after order preparation "
"has started."
msgstr "لم يعد من الممكن مراجعة الدفع عند الاستلام بعد بدء تجهيز الطلب."

msgid "Only the order owner can review the supplier."
msgstr "يحق لصاحب أمر الشراء وحده تقييم المورّد."

msgid "A review can be submitted only after order completion."
msgstr "لا يمكن إرسال التقييم إلا بعد اكتمال أمر الشراء."

msgid "This order has already been reviewed."
msgstr "تم تقييم هذا الأمر مسبقاً."

